# Foundation Console 后端配置示例。复制为 .env 或在进程管理器 / systemd 中设置。不要在此文件写真实凭据。
PORT=3000
# HOST=0.0.0.0
# 对外访问地址（用于同源校验），例如 https://console.example.com
# PFC_PUBLIC_URL=
# 运行数据目录，默认 server/data（首次启动自动创建）
# PFC_DATA_DIR=server/data
# 主密钥；不设置时首次启动自动生成 server/data/master.key
# PFC_MASTER_KEY=
# Steam Web API Key（也可在设置页由管理员填写，加密保存）
# PFC_STEAM_KEY=
# Node 直接提供 HTTPS 时的证书路径（使用 Nginx/Caddy 反代时不需要）
# SSL_CERT_PATH=
# SSL_KEY_PATH=
# HTTP_REDIRECT_PORT=
# ---- Microsoft Entra ID OAuth2（SMTP XOAUTH2，多租户公共客户端）----
# 默认 client ID 为平台内置公共应用（非机密，可直接使用）；如需换自己的应用再覆盖。
# PFC_MS_CLIENT_ID=05ff2f04-c7a1-46b6-b27d-af361e57b4d3
# 租户：common（默认，多租户）/ consumers / organizations / 具体租户 ID
# PFC_MS_TENANT=common
# 可选：仅机密客户端需要；公共客户端（默认）留空
# PFC_MS_CLIENT_SECRET=
# 可选：授权码 + PKCE 跳转流程的完整回调地址。默认流程为设备代码流，不需要此配置。
# 回调地址只从本变量或 PFC_PUBLIC_URL 推导，绝不使用请求 Host 头。
# PFC_MS_REDIRECT_URI=https://console.example.com/api/admin/smtp/ms/callback
# 可选：覆盖 OAuth scope（默认 https://outlook.office.com/SMTP.Send offline_access openid email profile）
# PFC_MS_SCOPES=
