{
  "name": "foundation-console",
  "private": true,
  "version": "0.2.0",
  "description": "Foundation Console (FDC) — GitHub Pages 演示分支（纯前端 + 浏览器内模拟后端），完整版见 main 分支",
  "license": "Apache-2.0",
  "author": "DNT_OF / DNTOF",
  "repository": {
    "type": "git",
    "url": "https://github.com/DNT-118/FoundationConsole.git"
  },
  "homepage": "https://github.com/DNT-118/FoundationConsole",
  "bugs": {
    "url": "https://github.com/DNT-118/FoundationConsole/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build --mode demo",
    "preview": "vite preview",
    "preview:demo": "vite preview --mode demo",
    "typecheck": "tsc -b --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.0.0",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-table": "^8.20.5",
    "dompurify": "^3.4.16",
    "framer-motion": "^11.11.0",
    "lucide-react": "^0.454.0",
    "marked": "^18.0.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.53.0",
    "react-router-dom": "^7.18.2",
    "three": "^0.169.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
